            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            // Bản giống hệt APK giao cho người dùng, để thử tốc độ thật.
            "name": "WorkDay (release)",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
